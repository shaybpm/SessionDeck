<UserControl x:Class="SessionDeck.TasksPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SessionDeck">
    <!-- The tasks page (T-0116, revised design 2026-07-27): replaces the deck's central
         area. Right: the full task list. Left: live session squares grouped by workspace
         (same ViewModels as the cards — statuses and blink stay live). Toolbar and status
         bar stay outside and unchanged. DataContext = MainViewModel. -->
    <DockPanel Background="#FF161616">
        <!-- left: session squares grouped by workspace. Docked BEFORE the header so the
             panel runs the full page height with a header of its own — otherwise the
             page title sat right above it and read as the panel's title
             (feedback 2026-07-27). Both headers share MinHeight so their bottom
             separator lines meet across the panel border. -->
        <Border DockPanel.Dock="Left" Width="240" Background="#FF1B1B1B"
                BorderBrush="#FF2E2E2E" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" MinHeight="32" Padding="10,0"
                        BorderBrush="#FF2E2E2E" BorderThickness="0,0,0,1">
                    <TextBlock Text="Active sessions" Foreground="#FF9A9A9A" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Workspaces}" Margin="8,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VisibleInDeck}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- workspace header, tinted like its card; click = focus -->
                                    <Border BorderBrush="{Binding CardBrush}" BorderThickness="0,0,0,2"
                                            Padding="2,0,2,2" Cursor="Hand"
                                            MouseLeftButtonUp="Workspace_MouseUp">
                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="12"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   FlowDirection="{Binding DisplayTitle, Converter={StaticResource Rtl}}"
                                                   ToolTip="{Binding Path}"/>
                                    </Border>
                                    <!-- open sessions as small status-bordered squares -->
                                    <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="22" Height="22" CornerRadius="4" Margin="0,0,5,5"
                                                        Background="#FF262626" BorderThickness="2"
                                                        BorderBrush="{Binding BorderBrush}" Cursor="Hand"
                                                        ToolTip="{Binding TooltipText}"
                                                        MouseLeftButtonUp="Session_MouseUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Closed}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Phantom}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FF3A3A3A"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- header: back + title + freshness — spans only the task-list column -->
        <Border DockPanel.Dock="Top" Background="#FF1B1B1B" MinHeight="32" Padding="8,0"
                BorderBrush="#FF2E2E2E" BorderThickness="0,0,0,1">
            <!-- Header reading order (feedback 2026-07-27, flipped to LTR with the English UI):
                 title at the left, ✕ at the far right, freshness filling the space between
                 them. The ✕ is icon-only, matching the toolbar icon buttons (⚙/🔍/📌/👁);
                 the full label + Esc hint live in its tooltip. -->
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" Click="Back_Click"
                        Background="Transparent" Foreground="White" FontSize="14"
                        BorderThickness="0" Padding="8,2" Margin="0,2" Cursor="Hand"
                        ToolTip="Back to the deck (Esc)"/>
                <TextBlock DockPanel.Dock="Left" Text="📋 Tasks" Foreground="White"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <!-- Freshness fills whatever is left of the title; on narrow windows it
                     trims with "…" instead of hard-clipping mid-number. -->
                <TextBlock Text="{Binding TasksPanel.GeneratedText}" Foreground="#FF888888"
                           FontSize="11" VerticalAlignment="Center" Margin="14,0,8,0"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TasksPanel.GeneratedText}"/>
            </DockPanel>
        </Border>

        <!-- record-level warnings: the list below is partial and says so -->
        <Border DockPanel.Dock="Top" Background="#FF2A2417" Padding="10,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TasksPanel.HasWarning}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- the warning quotes ids/names from the external file: direction follows the text -->
            <TextBlock Text="{Binding TasksPanel.WarningText}" Foreground="#FFE0A030" FontSize="11"
                       TextWrapping="Wrap"
                       FlowDirection="{Binding TasksPanel.WarningText, Converter={StaticResource Rtl}}"/>
        </Border>

        <!-- right: the tree navigation grid (#4.13.19). Docked AFTER the header rows on
             purpose, so it starts below them and its left border is the fixed vertical
             separator between the grid and the list. Two vertical columns, not horizontal
             rows: project 4 alone has over fifty direct children, which a row cannot hold
             and a column simply scrolls. Widths are fixed and do NOT follow the A+/A− font
             scale — the grid is sized to the strip of screen that was free, and a growing
             square would eat the list instead. -->
        <Border DockPanel.Dock="Right" Background="#FF1B1B1B" Padding="4,6"
                BorderBrush="#FF3E3E3E" BorderThickness="1,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- No map in the file (an older producer) = no grid at all. -->
                        <DataTrigger Binding="{Binding TasksPanel.HasNav}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Resources>
                <!-- One template for both columns; the handler tells them apart by which
                     collection the square belongs to. Fill = structure, border = status. -->
                <DataTemplate x:Key="NavSquare">
                    <Border Width="28" Height="28" CornerRadius="4" Margin="0,0,0,4"
                            Background="{Binding FillBrush}" BorderBrush="{Binding StatusBrush}"
                            BorderThickness="2" Cursor="Hand" ToolTip="{Binding TooltipText}"
                            MouseLeftButtonUp="NavSquare_MouseUp">
                        <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11"
                                   FlowDirection="LeftToRight"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
                <!-- column A: the top level. Fixed, never scrolls, ten squares, with the
                     "all projects" square above them — the only way out of a tree that does
                     not mean walking up it a level at a time. -->
                <StackPanel VerticalAlignment="Top" Margin="0,0,4,0">
                    <ContentControl Content="{Binding TasksPanel.NavHome}"
                                    ContentTemplate="{StaticResource NavSquare}"
                                    Margin="0,0,0,6">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TasksPanel.HasNavHome}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <ItemsControl ItemsSource="{Binding TasksPanel.NavRoots}"
                                  ItemTemplate="{StaticResource NavSquare}"/>
                </StackPanel>
                <!-- column B: the selected root's direct children, in a scroll area of its
                     own — the wheel over it scrolls the tree, the wheel past the separator
                     scrolls the tasks, which is WPF's own default and needs no code. The
                     width is fixed and includes room for the scrollbar, so the list beside
                     it never shifts sideways when a root with fifty children replaces one
                     with two. -->
                <ScrollViewer Width="46" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TasksPanel.NavChildren}"
                                  HorizontalAlignment="Left"
                                  ItemTemplate="{StaticResource NavSquare}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- center/right: the task list, or the file-level error state -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TasksPanel.HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <!-- 700 before the navigation grid took the right edge (#4.13.19): the grid
                     needs about 90px and only ~68 were free at 700. -->
                <StackPanel Margin="14,8" MaxWidth="650">
                    <ItemsControl ItemsSource="{Binding TasksPanel.PinnedTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:TaskItemView/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="#FF3E3E3E" Margin="4,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TasksPanel.ShowSeparator}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <ItemsControl ItemsSource="{Binding TasksPanel.OtherTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:TaskItemView/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <!-- file-level error replaces the list (T-0116: errors are shown, not hidden) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TasksPanel.HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="⚠" FontSize="34" Foreground="#FFE0A030" TextAlignment="Center"/>
                <TextBlock Text="The tasks file could not be loaded" Foreground="White" FontSize="15"
                           TextAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding TasksPanel.ErrorText}" Foreground="#FFAAAAAA" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                           FlowDirection="{Binding TasksPanel.ErrorText, Converter={StaticResource Rtl}}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
