<UserControl x:Class="SessionDeck.WorkspaceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SessionDeck"
             xmlns:services="clr-namespace:SessionDeck.Services">
    <UserControl.Resources>
        <!-- Hebrew-leading text renders RTL + right-aligned (issue 2026-07-19). Titles,
             descriptions and tab names come from outside the app, so they stay
             direction-aware even though the UI chrome itself is English. -->
        <services:FlowDirectionConverter x:Key="Rtl"/>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisibleInDeck}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border x:Name="RootBorder"
            BorderBrush="{Binding CardBrush}" BorderThickness="2" CornerRadius="8"
            Background="#FF1E1E1E" Margin="8" MinWidth="380" Cursor="Hand"
            MouseLeftButtonUp="Card_MouseUp">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Hidden}" Value="True">
                        <Setter Property="Opacity" Value="0.55"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <!-- header: project name + branch + actions, tinted with the card color -->
            <Grid DockPanel.Dock="Top">
                <Border Background="{Binding CardBrush}" Opacity="0.25" CornerRadius="6,6,0,0"/>
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <!-- WrapPanel (feedback 2026-07-27): a long title/branch used to
                             overflow the header StackPanel INTO the action buttons. Now
                             long values are ellipsis-trimmed (full text in the tooltip),
                             and the branch+tabs pills drop to a second row AS ONE UNIT
                             when the first row runs out of room. -->
                        <WrapPanel>
                            <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontWeight="Bold"
                                       FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=14}" MaxWidth="300" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       FlowDirection="{Binding DisplayTitle, Converter={StaticResource Rtl}}"
                                       ToolTip="{Binding TitleTooltip}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#33FFFFFF" CornerRadius="8" Padding="7,1" Margin="8,1,0,1"
                                        VerticalAlignment="Center" ToolTip="{Binding Branch}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBranch}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- branch names come from git and are not always Latin -->
                                    <TextBlock Foreground="#FFDDDDDD" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=11}" MaxWidth="280"
                                               TextTrimming="CharacterEllipsis"
                                               FlowDirection="{Binding Branch, Converter={StaticResource Rtl}}">
                                        <Run Text="&#x2387;"/> <Run Text="{Binding Branch}"/>
                                    </TextBlock>
                                </Border>
                                <!-- open Claude Code tabs, reported by the VSCode extension (stage D) -->
                                <Border Background="#33FFFFFF" CornerRadius="8" Padding="7,1" Margin="6,1,0,1"
                                        VerticalAlignment="Center" ToolTip="{Binding ClaudeTabsTooltip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasClaudeTabs}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="#FFDDDDDD" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=11}">
                                        <Run Text="📑"/> <Run Text="{Binding ClaudeTabCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Foreground="#FFAAAAAA" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=11}"
                                   TextTrimming="CharacterEllipsis"
                                   FlowDirection="{Binding Description, Converter={StaticResource Rtl}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Description}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <!-- BasedOn keeps the app-wide rounded template -->
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="6,2"/>
                            </Style>
                        </StackPanel.Resources>
                        <!-- linked tasks from the external tasks file (T-0116);
                             label = count, disabled at 0, hidden when the feature is off -->
                        <Button x:Name="TasksButton" Click="Tasks_Click">
                            <TextBlock>
                                <Run Text="🗒"/><Run Text=" "/><Run Text="{Binding WorkspaceTasks.Count, Mode=OneWay}"/>
                            </TextBlock>
                            <Button.Style>
                                <!-- ToolTip lives in the style (not on the element) so the
                                     open-state trigger can swap it (T-0236) -->
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="ToolTip" Value="Tasks linked to this workspace"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TasksEnabled}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WorkspaceTasks.Count}" Value="0">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                        <!-- pressed look while the inline list is open (T-0236) -->
                                        <DataTrigger Binding="{Binding TasksExpanded}" Value="True">
                                            <Setter Property="Background" Value="#FF2E4A66"/>
                                            <Setter Property="ToolTip" Value="Hide the tasks"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="▶" Click="Pin_Click" ToolTip="Move the window to the configured Stage area"/>
                        <Button x:Name="ExpandButton" Content="▼" Click="Expand_Click">
                            <Button.Style>
                                <!-- glyph swap stays in code-behind (SyncExpandGlyph); the style
                                     adds the matching pressed look + tooltip swap (T-0236) -->
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="ToolTip" Value="Show closed sessions too"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Expanded}" Value="True">
                                            <Setter Property="Background" Value="#FF2E4A66"/>
                                            <Setter Property="ToolTip" Value="Hide closed sessions"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- all card actions live in one ⋯ menu (feedback 2026-07-19) -->
                        <Button x:Name="MenuButton" Content="⋯" FontWeight="Bold" Click="Menu_Click"
                                ToolTip="Actions">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit" Click="Edit_Click"/>
                                    <MenuItem x:Name="CopyPathMenuItem" Header="Copy path to clipboard"
                                              Click="CopyPath_Click"/>
                                    <MenuItem x:Name="HideMenuItem" Header="Hide" Click="Hide_Click"/>
                                    <MenuItem x:Name="CloseWindowMenuItem" Header="Close window"
                                              Click="CloseWindow_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Remove card" Click="Remove_Click"
                                              Foreground="#FFCC7777"
                                              ToolTip="Removes the workspace from the deck (does not close the window)"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- session cards: status-colored borders, no thumbnails -->
            <StackPanel DockPanel.Dock="Bottom" Margin="8,2,8,8">
            <Button Content="+ New session" Click="NewSession_Click" Cursor="Hand"
                    HorizontalAlignment="Left" Padding="10,2" Margin="0,2,0,3"
                    Background="#FF2E4A66" Foreground="White" BorderThickness="0"
                    ToolTip="Open a new Claude Code conversation in this workspace"/>
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{Binding BorderBrush}" BorderThickness="2" CornerRadius="5"
                                Margin="0,3" Padding="8,4" Cursor="Hand"
                                MouseLeftButtonUp="Session_MouseUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FF262626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Closed}" Value="True">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                        <!-- clickable affordance (issue 2026-07-19) -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF333333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ToolTip>
                                    <ToolTip>
                                        <!-- RTL when the first line (Detail) starts with Hebrew -->
                                        <TextBlock Text="{Binding TooltipText}" MaxWidth="420" TextWrapping="Wrap"
                                                   FlowDirection="{Binding TooltipText, Converter={StaticResource Rtl}}"/>
                                    </ToolTip>
                                </Grid.ToolTip>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!-- primary: the VSCode tab title; wraps instead of truncating -->
                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=12}"
                                               TextWrapping="Wrap"
                                               FlowDirection="{Binding DisplayTitle, Converter={StaticResource Rtl}}"/>
                                    <!-- secondary session title (AutoTitle via SubTitle) removed by request
                                         2026-07-19; the VM property still exists. To restore, re-add here a
                                         TextBlock bound to SubTitle (wrap + Rtl converter, collapsed when ""). -->
                                    <TextBlock Text="{Binding SubText}" Foreground="#FF999999" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=10}"
                                               TextTrimming="CharacterEllipsis"
                                               FlowDirection="{Binding SubText, Converter={StaticResource Rtl}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SubText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <TextBlock Text="📑" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=11}" Margin="0,0,6,0"
                                               ToolTip="Open as a tab in VSCode">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OpenAsTab}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusDisplay}" Foreground="#FFBBBBBB" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=11}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

            <!-- inline task list (T-0116): the 🗒 button toggles it; same card UI as the
                 tasks page. Docked after the sessions panel so it renders above it. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TasksExpanded}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ItemsControl ItemsSource="{Binding WorkspaceTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:TaskItemView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- live DWM thumbnail of the bound VSCode window -->
            <Grid Height="170">
                <Border x:Name="ThumbArea" Background="#FF0D0D0D" Margin="8,6,8,2" CornerRadius="4"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Disconnected">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🔌 No VSCode window open" Foreground="#FF888888" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=14}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Click to open the project in VSCode" Foreground="#FF555555" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=11}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
