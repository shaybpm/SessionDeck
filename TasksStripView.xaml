<UserControl x:Class="SessionDeck.TasksStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Collapsed tasks strip (T-0116): a narrow column of status-colored squares at the
         right edge of the deck; hover shows details, click activates the task. The 📋
         button at the top opens the full tasks page. DataContext = MainViewModel. -->
    <UserControl.Resources>
        <!-- one task square; pinned tasks get a white outline -->
        <DataTemplate x:Key="TaskSquare">
            <Border Width="22" Height="22" CornerRadius="4" Margin="0,3"
                    Background="{Binding StatusBrush}" Cursor="Hand"
                    ToolTip="{Binding TooltipText}"
                    MouseLeftButtonUp="Square_MouseUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="BorderBrush" Value="White"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TasksPanel.Enabled}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border Background="#FF1B1B1B" BorderBrush="#FF2E2E2E" BorderThickness="1,0,0,0">
        <DockPanel Margin="5,4">
            <Button DockPanel.Dock="Top" Content="📋" FontSize="14" ToolTip="Tasks page"
                    Background="Transparent" Foreground="White" BorderThickness="0"
                    Padding="2,3" Cursor="Hand" Click="OpenPage_Click">
                <Button.Style>
                    <!-- BasedOn keeps the app-wide rounded template -->
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </Button.Style>
            </Button>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                    <!-- file-level error: one warning square instead of the list -->
                    <TextBlock Text="⚠" FontSize="16" Foreground="#FFE0A030" TextAlignment="Center"
                               ToolTip="{Binding TasksPanel.ErrorText}" Cursor="Help">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TasksPanel.HasError}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- record-level warning: small indicator above the (partial) list -->
                    <TextBlock Text="⚠" FontSize="11" Foreground="#FFE0A030" TextAlignment="Center"
                               ToolTip="{Binding TasksPanel.WarningText}" Cursor="Help">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TasksPanel.HasWarning}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding TasksPanel.PinnedTasks}"
                                  ItemTemplate="{StaticResource TaskSquare}"/>
                    <Border Height="1" Background="#FF3E3E3E" Margin="1,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TasksPanel.ShowSeparator}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <ItemsControl ItemsSource="{Binding TasksPanel.OtherTasks}"
                                  ItemTemplate="{StaticResource TaskSquare}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
