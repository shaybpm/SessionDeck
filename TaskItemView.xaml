<UserControl x:Class="SessionDeck.TaskItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One task card (T-0116): name + optional status/description, action buttons.
         DataContext = TaskItemViewModel. Used by the tasks page and by the workspace
         card's inline task list. -->
    <!-- The whole card is a click target (not only the buttons), and it carries no tooltip:
         everything a tooltip would show is already printed on the card. The narrow squares
         in TasksStripView DO keep theirs - there the tooltip is the only way to read a task. -->
    <Border BorderBrush="{Binding StatusBrush}" BorderThickness="2" CornerRadius="5"
            Margin="0,3" Padding="8,5" Background="#FF262626"
            Cursor="Hand" MouseLeftButtonUp="Card_MouseUp">
        <StackPanel>
            <!-- Fixed reading order, independent of the task's language: id hard left, then
                 status, then the name filling the rest and right-aligned. Deriving the header
                 direction from the name (the Rtl converter) made a Hebrew task and an English
                 one line up differently, which is what a scan down the list trips over. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Id}" Foreground="#FF777777" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=10}"
                               VerticalAlignment="Center"/>
                    <!-- status text comes from the external file: direction follows its content -->
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=11}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               FlowDirection="{Binding Status, Converter={StaticResource Rtl}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatus}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- RightToLeft mirrors layout as well as glyphs, so Dock=Left puts the pin on
                     the right of the name, which is the side the text now starts from. -->
                <DockPanel Grid.Column="1" FlowDirection="RightToLeft">
                    <TextBlock DockPanel.Dock="Left" Text="📌" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=10}" Margin="0,1,4,0"
                               VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pinned}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- A card that navigates (it has a url: a parent that drills into its
                         own level, or the producer's back/toggle cards) is painted as a
                         hyperlink — blue and underlined. The emoji marker a producer may put
                         in the name was not enough to spot while scanning (feedback
                         07-08-2026); colour reads before the eye reaches the glyph. -->
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=12}"
                               FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUrl}" Value="True">
                                        <Setter Property="Foreground" Value="#FF6FB7FF"/>
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Grid>
            <TextBlock Text="{Binding Description}" Foreground="#FF999999" FontSize="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=10.5}"
                       TextWrapping="Wrap" Margin="0,2,0,0"
                       FlowDirection="{Binding Description, Converter={StaticResource Rtl}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <StackPanel.Resources>
                    <!-- BasedOn keeps the app-wide rounded template -->
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#FF333333"/>
                        <Setter Property="Foreground" Value="#FFDDDDDD"/>
                        <Setter Property="Padding" Value="9,2"/>
                        <Setter Property="Margin" Value="0,0,6,0"/>
                        <!-- Setter.Value takes a binding, so the card's buttons grow with its
                             text instead of staying behind at a fixed 11. -->
                        <Setter Property="FontSize" Value="{Binding DataContext.TasksPanel.FontScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontScale}, ConverterParameter=11}"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="TargetButton" Content="{Binding TargetButtonText}"
                        Click="Target_Click"
                        ToolTip="Open a session for this task — an existing one, or a new one in its workspace">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTarget}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- The producer names this button (UrlButtonText): only it knows whether the
                     url is a document or a drill into this card's sub-tasks. Its text is
                     external and often Hebrew, so its direction follows the text. -->
                <Button Content="{Binding UrlButtonText}" Click="Url_Click"
                        FlowDirection="{Binding UrlButtonText, Converter={StaticResource Rtl}}"
                        ToolTip="{Binding Url}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUrl}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
