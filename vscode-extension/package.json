{
  "name": "sessiondeck-connector",
  "displayName": "SessionDeck Connector",
  "description": "Reports Claude Code tabs and the git branch to SessionDeck, and opens/resumes Claude sessions on request.",
  "version": "0.6.12",
  "publisher": "eyal-sinay",
  "repository": {
    "type": "git",
    "url": "https://github.com/eyalBPM/SessionDeck.git"
  },
  "icon": "assets/logo128.png",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sessiondeck.sync",
        "title": "SessionDeck: Sync Now"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.9.3"
  }
}
