<Window x:Class="SessionDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SessionDeck"
        xmlns:services="clr-namespace:SessionDeck.Services"
        Title="SessionDeck" Height="700" Width="1100"
        MinWidth="480"
        Background="#FF161616">
    <!-- MinWidth 480 = card (430) + card margins (16) + vertical scrollbar + window frame:
         below that the first card/toolbar controls get clipped and the window is unusable.
         AppBarService derives the minimal zone width from this value too. -->
    <Window.Resources>
        <!-- the "Rtl" converter now lives in App.xaml (shared by every window/dialog) -->
        <!-- toolbar icon toggle: accent background while checked (pressed-state UI) -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF333333"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF3A6EA5"/>
                            </Trigger>
                            <!-- Feedback 2026-07-27: without this the disabled 🔍 (tasks-page
                                 mutual exclusion) looked identical to enabled — users read it
                                 as a broken button. Same fade as the app-wide Button style. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF232323" Padding="10,6">
            <!-- responsive toolbar (feedback 2026-07-21): the toggle strip stays docked
                 right; the left controls live in a WrapPanel so on a narrow window whole
                 groups wrap to a second row instead of being clipped off-screen -->
            <DockPanel x:Name="ToolbarRoot" LastChildFill="True" SizeChanged="ToolbarLayout_Changed">
                <!-- icon strip wraps icon-by-icon when the window gets too narrow; being
                     right-docked it is measured before the combos, so ToolbarLayout_Changed
                     caps its MaxWidth to whatever the widest left group leaves free.
                     This panel's RightToLeft is a LAYOUT device, not a language one (the strip
                     is icons only): reversed child order makes the LEFTMOST icons overflow to
                     the next row first, so ⚙ (rightmost) always stays on the top row -->
                <WrapPanel x:Name="IconStrip" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Margin="12,0,0,0" FlowDirection="RightToLeft">
                    <Button x:Name="SettingsButton" Content="⚙" FontSize="15" ToolTip="Settings"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Padding="8,2" Margin="0,2" Cursor="Hand" Click="Settings_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="StartupMenuItem" Header="Start with Windows"
                                          IsCheckable="True" Click="StartupMenuItem_Click"/>
                                <MenuItem x:Name="MaximizeSessionMenuItem" Header="Collapse the VSCode panels when opening a session"
                                          IsCheckable="True" Click="MaximizeSessionMenuItem_Click"
                                          ToolTip="When a session is clicked on the deck: close the side and bottom panels so the tab fills the whole area"/>
                                <MenuItem x:Name="NotificationsMenuItem" Header="Windows notifications"
                                          IsCheckable="True" Click="NotificationsMenuItem_Click"
                                          ToolTip="When on: a session that needs attention raises a Windows notification, a colored dot on the taskbar icon and a single flash.&#10;Active only while both 📌 and the Zone are off — in any other state the deck is visible anyway, and the card blink is enough.&#10;Even then, no notification is shown while the deck has focus."/>
                                <Separator/>
                                <MenuItem Header="Tasks file (JSON)..." Click="TasksFileMenuItem_Click"
                                          ToolTip="A read-only tasks panel fed by an external JSON file (a TaskDeck export, for instance). Empty = off"/>
                                <MenuItem Header="Toggles (flags)..." Click="TogglesMenuItem_Click"
                                          ToolTip="Toolbar toggle buttons whose state is written to a flag file — for driving external processes"/>
                                <Separator/>
                                <MenuItem x:Name="VersionMenuItem" IsEnabled="False"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <ToggleButton x:Name="PinTopToggle" Content="📌" FontSize="13"
                                  ToolTip="Pin: keep the window always on top"
                                  Style="{StaticResource IconToggle}"
                                  Checked="PinTop_Changed" Unchecked="PinTop_Changed"/>
                    <ToggleButton x:Name="ShowHiddenToggle" Content="👁" FontSize="13"
                                  ToolTip="Show hidden workspaces too"
                                  Style="{StaticResource IconToggle}"
                                  Checked="ShowHidden_Changed" Unchecked="ShowHidden_Changed"/>
                    <ToggleButton x:Name="ActiveOnlyToggle" Content="⚡" FontSize="13"
                                  ToolTip="Open only: hide the workspaces with no window and no live session. Every session on a shown card stays visible."
                                  Style="{StaticResource IconToggle}"
                                  Checked="ActiveOnly_Changed" Unchecked="ActiveOnly_Changed"/>
                    <!-- Card text size. Plain buttons rather than toggles: this is a value
                         that steps, not a state that is on or off. The strip is RightToLeft
                         as a layout device, so A+ is declared first to sit left of A-. -->
                    <Button x:Name="FontBiggerButton" Content="A+" FontSize="12"
                            ToolTip="Larger text in the cards"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Padding="6,2" Margin="0,2" Cursor="Hand" Click="FontBigger_Click"/>
                    <Button x:Name="FontSmallerButton" Content="A-" FontSize="12"
                            ToolTip="Smaller text in the cards"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Padding="6,2" Margin="0,2" Cursor="Hand" Click="FontSmaller_Click"/>
                    <!-- divider between user flags and the built-in toolbar toggles;
                         hidden when no flags are defined -->
                    <Border Width="1" Margin="6,3" Background="#FF3E3E3E">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CustomToggles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- user-defined toggles (config: customToggles) — state exported to
                         flag files for external processes to read. Inner panel back to LTR
                         so the user-defined order still reads left-to-right -->
                    <ItemsControl ItemsSource="{Binding CustomToggles}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel FlowDirection="LeftToRight"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Icon}" FontSize="13"
                                              ToolTip="{Binding Tooltip}"
                                              Style="{StaticResource IconToggle}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <!-- two-stage wrap: the inner WrapPanel holds Zone+Stage, so they first drop
                     together as one unit below the button; only when a full row can't hold
                     both does Stage drop to its own row. Dividers hide when a wrap separates
                     their neighbors (see UpdateToolbarDividers). -->
                <WrapPanel x:Name="ToolbarWrap" VerticalAlignment="Center"
                           SizeChanged="ToolbarLayout_Changed">
                    <StackPanel x:Name="AddGroup" Orientation="Horizontal" Margin="0,3">
                        <Button x:Name="AddWorkspaceButton" Click="AddWorkspace_Click"
                                Style="{StaticResource AccentButton}"
                                ToolTip="Pick a project folder to add to the deck">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBlock Text="Add workspace"/>
                            </StackPanel>
                        </Button>
                        <Border x:Name="ToolbarDiv1" Width="1" Height="20" Background="#FF3E3E3E"
                                Margin="14,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel x:Name="ZoneStageWrap" SizeChanged="ToolbarLayout_Changed">
                        <StackPanel x:Name="ZoneGroup" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Zone:" Foreground="#FFBBBBBB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ZoneMonitorCombo" Width="140" SelectionChanged="ZoneUi_Changed"/>
                            <ComboBox x:Name="ZoneModeCombo" Width="152" Margin="4,0,0,0" SelectionChanged="ZoneUi_Changed"
                                      DropDownClosed="ZoneModeCombo_DropDownClosed"/>
                            <Border x:Name="ToolbarDiv2" Width="1" Height="20" Background="#FF3E3E3E"
                                    Margin="14,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="StageGroup" Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Stage:" Foreground="#FFBBBBBB" Margin="0,0,6,0" VerticalAlignment="Center"
                                       ToolTip="Where a window lands when ▶ (Stage) is clicked"/>
                            <ComboBox x:Name="StageMonitorCombo" Width="140" SelectionChanged="StageUi_Changed"/>
                            <ComboBox x:Name="StageModeCombo" Width="118" Margin="4,0,0,0" SelectionChanged="StageUi_Changed"/>
                        </StackPanel>
                    </WrapPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Search / filter row (feature 2026-07-19; made permanent 07-08-2026). It is always
             on screen and always filters WHAT IS CURRENTLY SHOWING: the task list while the
             tasks page is up, workspaces + sessions otherwise. It used to be a 🔍 toggle that
             was mutually exclusive with the tasks page, so on the page there was no search at
             all and nothing said why. The scope label spells out which of the two is being
             filtered, since the box itself looks identical either way. -->
        <Border x:Name="SearchRow" DockPanel.Dock="Top" Background="#FF1B1B1B" Padding="8,5">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="SearchScopeLabel" DockPanel.Dock="Left" Text="🔍 Sessions"
                           Foreground="#FF9A9A9A" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <!-- Transcript search belongs to sessions only; hidden on the tasks page. -->
                <CheckBox x:Name="SearchContentCheck" DockPanel.Dock="Right" Content="Search content too"
                          Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="14,0,6,0"
                          Checked="SearchContent_Changed" Unchecked="SearchContent_Changed"
                          ToolTip="Search inside the sessions' transcript files (jsonl) as well"/>
                <!-- match count, tasks only: a narrow query that hides everything must not
                     look like a panel that lost its content -->
                <TextBlock x:Name="SearchCountLabel" DockPanel.Dock="Right" FontSize="11"
                           Foreground="#FF888888" VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="{Binding TasksPanel.FilterNote}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TasksPanel.HasFilterNote}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- the query is user input and is often Hebrew: direction follows what is typed -->
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" FontSize="13"
                         Background="#FF2A2A2A" Foreground="White" BorderBrush="#FF444444"
                         CaretBrush="White" Padding="6,3"
                         FlowDirection="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource Rtl}}"
                         TextChanged="Search_Changed"/>
            </DockPanel>
        </Border>

        <!-- status bar: full width at the window bottom, outside the scroll area, so long
             messages never crowd the toolbar (feedback 2026-07-19) -->
        <Border DockPanel.Dock="Bottom" Background="#FF232323" Padding="12,9" MinHeight="42">
            <DockPanel LastChildFill="True">
                <!-- session-status summary (feature 2026-07-19): a dot per (status, blinking)
                     group, colored like the session borders; empty groups are not shown.
                     LTR panel so the most urgent group comes first in reading order. -->
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding StatusSummary}"
                              VerticalAlignment="Center" Margin="12,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                        ToolTip="{Binding Tooltip}">
                                <Ellipse Width="11" Height="11" Fill="{Binding DotBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Count}" Foreground="#FFBBBBBB" FontSize="12"
                                           Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="StatusText" Foreground="#FF999999" TextWrapping="Wrap"
                           VerticalAlignment="Center" FontSize="12.5"
                           FlowDirection="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource Rtl}}"/>
            </DockPanel>
        </Border>

        <Grid>
            <!-- deck view: workspace cards + the collapsed tasks strip (T-0116) -->
            <DockPanel x:Name="DeckView">
                <local:TasksStripView x:Name="TasksStrip" DockPanel.Dock="Right"/>
                <Grid>
                    <!-- SizeChanged on the ScrollViewer, not the ItemsControl: the ItemsControl
                         is sized BY its content, so asking it how wide it is would feed the card
                         width back into itself. The viewport is the only independent number. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" SizeChanged="CardsHost_SizeChanged">
                        <ItemsControl x:Name="CardsHost" ItemsSource="{Binding Workspaces}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Width is computed from the viewport so a row of cards
                                         fills it exactly instead of leaving a dead margin.
                                         A WrapPanel cannot stretch its children itself, and a
                                         UniformGrid that could would also force every card to the
                                         height of the tallest one, which is worse. -->
                                    <local:WorkspaceCardView
                                        Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="#FF666666" FontSize="15" TextAlignment="Center"
                               Text="The deck is empty&#10;Click “+ Add workspace” and pick a project folder,&#10;or start a Claude Code session with the hooks installed (see the hooks folder)"/>
                </Grid>
            </DockPanel>
            <!-- tasks page: swapped with DeckView (T-0116 revised design — page, not expand) -->
            <local:TasksPageView x:Name="TasksPage" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
